// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  mode               String    @default("PERSONAL") // PERSONAL | PROFESSIONAL (legacy, kept for data compat)
  timezone           String    @default("Europe/Paris")
  plan               String    @default("FREE") // FREE | PRO
  subscriptionStatus String    @default("INACTIVE") // INACTIVE | ACTIVE | TRIAL | EXPIRED
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  aiQuotaUsed        Int       @default(0)
  aiQuotaResetAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  events        Event[]
  reminders     Reminder[]
  tasks         Task[]
  contacts      Contact[]
  pushSubs      PushSubscription[]
  memories      UserMemory[]
  agentLogs     AgentLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  notes       String?
  startAt     DateTime
  endAt       DateTime?
  location    String?
  category    String    @default("OTHER") // HEALTH|FAMILY|WORK|ADMIN|EDUCATION|SHOPPING|TRAVEL|OTHER
  priority    String    @default("NORMAL") // LOW|NORMAL|HIGH|URGENT
  mode        String    @default("PERSONAL") // PERSONAL|PROFESSIONAL
  isRecurring Boolean   @default(false)
  recurrence  String?   // JSON string: {type, days, until}
  contactId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id])
  reminders Reminder[]
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  eventId   String?
  taskId    String?
  title     String
  body      String?
  fireAt    DateTime // UTC
  status    String   @default("PENDING") // PENDING|FIRED|DISMISSED|SNOOZED
  snoozedTo DateTime?
  method    String   @default("NOTIFICATION") // NOTIFICATION|ALARM|EMAIL|VOICE
  isVeille  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  notes     String?
  dueAt     DateTime?
  priority  String    @default("NORMAL") // LOW|NORMAL|HIGH|URGENT
  mode      String    @default("PERSONAL") // PERSONAL|PROFESSIONAL
  isDone    Boolean   @default(false)
  items     String?   // JSON: [{label, qty, done}]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]
}

model Contact {
  id        String  @id @default(cuid())
  userId    String
  firstName String
  lastName  String?
  phone     String?
  email     String?
  company   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String   // ex: "preferred_reminder_minutes", "favorite_supplier"
  value     String   // valeur stockée
  source    String   @default("AI") // AI | USER | SYSTEM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model AgentLog {
  id          String   @id @default(cuid())
  userId      String
  tool        String   // ex: "create_event", "organize_day"
  params      String?  // JSON sanitized (no secrets)
  success     Boolean  @default(true)
  errorMsg    String?
  durationMs  Int?
  aiRequestId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

